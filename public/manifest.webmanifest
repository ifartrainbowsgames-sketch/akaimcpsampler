{
  "name": "MPC SAMPLE",
  "short_name": "MPC SAMPLE",
  "description": "A browser-based MPC-style sampler and sequencer.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAFAF8",
