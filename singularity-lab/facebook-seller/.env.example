# Copy this file to fb_tool/.env and fill in values
# NEVER commit .env to git

FB_EMAIL="your_facebook_email@example.com"
FB_PASSWORD="your_facebook_password"
OPENAI_API_KEY="sk-your-openai-key-optional-for-ai-posts"
HEADLESS_MODE="False"
SCROLL_DELAY="3"
COMMENT_DELAY="5"
FRIEND_REQUEST_DELAY="10"
LIKE_DELAY="5"

# Delays in seconds — higher = safer for Facebook account
