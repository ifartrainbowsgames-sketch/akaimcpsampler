# Optional — enables Freesound browse for all users without their own key.
# Set BOTH on Vercel (Environment Variables) then redeploy:
#   FREESOUND_API_KEY=your_key          (server API routes)
#   VITE_FREESOUND_API_KEY=your_key     (built into the app)
# Get a free key at https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
VITE_FREESOUND_API_KEY=
